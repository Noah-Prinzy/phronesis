# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# At least one of ANTHROPIC_API_KEY / GEMINI_API_KEY is required — Gemini is
# preferred when both are set (see ai.service.ts). Claude: console.anthropic.com
ANTHROPIC_API_KEY=

# Also required for /api/tts (Gemini's native TTS is Phronesis' voice) in
# addition to being the free stand-in for Claude while a custom model
# trains. Free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional — only used by /api/tts-local, which nothing calls yet (Sunbird's
# TTS covers Ugandan languages, not English — see sunbird.service.ts).
# Get one at https://sunbird.ai.
SUNBIRD_API_KEY=

# Phronesis' voice needs NO KEY. /api/tts uses Microsoft's neural speech
# (msedge-tts), which has no account and no quota, and runs on the server so
# every device and browser gets the same voice. Optional overrides:
#   EDGE_TTS_VOICE  en-GB-SoniaNeural (default) | LibbyNeural | MaisieNeural
#                   | RyanNeural | ThomasNeural
#   EDGE_TTS_RATE   -6% (default). Negative is slower.
# Gemini sits behind it as a fallback using GEMINI_API_KEY above, though its
# free tier is only ten TTS requests per DAY. See services/edge.service.ts for
# why this provider was chosen and what to swap to before a commercial release.

# Port the server listens on.
PORT=3001

# Origin allowed to call this API in dev — the Vite dev server's URL.
# In production, set this to your deployed frontend's origin (Vercel URL).
CORS_ORIGIN=http://localhost:5173
