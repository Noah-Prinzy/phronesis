# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — only used by /api/tts-local, which nothing calls yet (Sunbird's
# TTS covers Ugandan languages, not English — see sunbird.service.ts).
# Get one at https://sunbird.ai.
SUNBIRD_API_KEY=

# Port the server listens on.
PORT=3001

# Origin allowed to call this API in dev — the Vite dev server's URL.
# In production, set this to your deployed frontend's origin (Vercel URL).
CORS_ORIGIN=http://localhost:5173
