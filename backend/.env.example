# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# GEMINI_API_KEY is required. It is the only model key: it answers chat, runs
# the diagnosis, speaks as Phronesis via /api/tts, and is the only provider
# here that can read a photo or listen to a recording.
# Free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional — only used by /api/tts-local, which nothing calls yet (Sunbird's
# TTS covers Ugandan languages, not English — see sunbird.service.ts).
# Get one at https://sunbird.ai.
SUNBIRD_API_KEY=

# Phronesis' voice needs NO KEY. /api/tts uses Microsoft's neural speech
# (msedge-tts), which has no account and no quota, and runs on the server so
# every device and browser gets the same voice. Optional overrides:
#   EDGE_TTS_VOICE  en-IE-EmilyNeural (default, Irish) | en-GB-SoniaNeural
#                   | en-GB-LibbyNeural | en-GB-MaisieNeural
#                   | en-GB-RyanNeural | en-GB-ThomasNeural | en-IE-ConnorNeural
#   EDGE_TTS_RATE   0% (default). Negative is slower, e.g. -12%.
# Gemini sits behind it as a fallback using GEMINI_API_KEY above, though its
# free tier is only ten TTS requests per DAY. See services/edge.service.ts for
# why this provider was chosen and what to swap to before a commercial release.

# Firestore, which is what makes anything outlive a reload — saved cars,
# chat history, past diagnoses, preferences. WITHOUT THESE the server still
# runs and the app still works; nothing is stored, and it says so once at
# startup rather than failing per request.
#
# From the Firebase console: Project settings > Service accounts >
# Generate new private key. Copy the two fields out of the JSON it downloads.
# Keep the private key on ONE line, with its line breaks written as the two
# characters backslash-n. The server converts them back.
FIREBASE_PROJECT_ID=phronesis-51bc9
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Port the server listens on. The frontend's VITE_API_BASE_URL must match.
PORT=3001

# Origin allowed to call this API in dev — the Vite dev server's URL.
# In production, set this to your deployed frontend's origin (Vercel URL).
CORS_ORIGIN=http://localhost:5173
