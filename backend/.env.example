# Copy this to .env and fill in real values. .env is gitignored — never commit it.

# At least one of ANTHROPIC_API_KEY / GEMINI_API_KEY is required — Gemini is
# preferred when both are set (see ai.service.ts). Claude: console.anthropic.com
ANTHROPIC_API_KEY=

# Also required for /api/tts (Gemini's native TTS is Phronesis' voice) in
# addition to being the free stand-in for Claude while a custom model
# trains. Free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional — only used by /api/tts-local, which nothing calls yet (Sunbird's
# TTS covers Ugandan languages, not English — see sunbird.service.ts).
# Get one at https://sunbird.ai.
SUNBIRD_API_KEY=

# Phronesis' voice. /api/tts tries providers in order — Piper, ElevenLabs,
# then Gemini — and moves on when one fails rather than when one is missing.
#
# NO KEY IS NEEDED FOR HER TO SPEAK. Run `npm run setup:piper` and Piper runs
# locally on the CPU, with no quota and no per-character cost; it is first in
# the chain for exactly that reason. ElevenLabs is the nicer voice when it is
# funded, but its free grant is 10,000 characters for the LIFE OF THE ACCOUNT
# — about fifteen replies — so it is a quality upgrade, not a foundation.
# Optional. Get a key at https://elevenlabs.io.
ELEVENLABS_API_KEY=

# Optional — which ElevenLabs voice to speak with. Defaults to "Rachel", a
# premade voice, if left blank.
ELEVENLABS_VOICE_ID=

# Port the server listens on.
PORT=3001

# Origin allowed to call this API in dev — the Vite dev server's URL.
# In production, set this to your deployed frontend's origin (Vercel URL).
CORS_ORIGIN=http://localhost:5173
