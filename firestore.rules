rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User nested car profiles
      match /cars/{carId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level car profiles
    match /cars/{carId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Alert switches. Same shape as /users: the document id IS the uid, so a
    // user can only ever reach their own.
    //
    // These rules are the ONLY thing guarding this data — the app writes it
    // straight from the browser rather than through a server, because a
    // server in the middle would enforce nothing these do not. They have to
    // be deployed to take effect: `firebase deploy --only firestore:rules`.
    match /preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /diagnoses/{diagnosisId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Co-pilot chat sessions
    match /chats/{chatId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
