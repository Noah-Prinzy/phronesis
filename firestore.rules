rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User nested car profiles
      match /cars/{carId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level car profiles
    match /cars/{carId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Diagnostic reports
    // Alert switches. Same shape as /cars: the document id IS the uid, so a
    // user can only ever reach their own. Written by the backend through the
    // Admin SDK, which bypasses these rules — they exist for the case where
    // a client reaches Firestore directly, and to make the intent explicit.
    match /preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /diagnoses/{diagnosisId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Co-pilot chat sessions
    match /chats/{chatId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
